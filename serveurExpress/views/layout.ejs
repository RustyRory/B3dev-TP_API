<!DOCTYPE html>
<html lang="fr">
  <%- include('./partials/head', { title }) %>

  <body class="<%= isAdmin ? 'admin' : '' %>">
    <%- include('./partials/header') %>

    <main>
      <% if (isAdmin) { %>
      <div class="admin-notice">Mode administrateur activé</div>
      <% } %> <% if (username) { %>
      <p>Bienvenue <strong><%= username %></strong></p>
      <% } %> <%- content %>
    </main>

    <%- include('./partials/footer') %>
  </body>
</html>
