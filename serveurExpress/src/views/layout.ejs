<!-- 

path: serveurExpress/src/views/layout.ejs 
title: Layout principal pour l'application Express

Utilise des partiels pour le head, header et footer et intègre le contenu dynamique

-->
<!DOCTYPE html>
<html lang="fr">
  <!-- Inclusion du partiel head avec le titre dynamique -->
  <%- include('./partials/head', { title }) %>

  <!-- gestion du cookie admin -->
  <body class="d-flex flex-column min-vh-100 <%= isAdmin ? 'admin' : '' %>">
    <!-- Inclusion du partiel header -->
    <%- include('./partials/header') %>

    <!-- Contenu principal -->
    <main class="container flex-fill mt-4"><%- body %></main>

    <!-- Inclusion du partiel footer -->
    <%- include('./partials/footer') %>

    <!-- Scripts JS -->
    <!-- Bootstrap JS Bundle avec Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Script pour le tchat -->
    <script src="/socket.io/socket.io.js"></script>
    <!-- Script personnalisé pour le tchat -->
    <script src="/js/tchat.js"></script>
  </body>
</html>
