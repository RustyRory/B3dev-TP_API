<!-- 

Path: serveurExpress/src/views/pages/404.ejs
Title: Page 404 - Non trouvée

Utilise le layout principal pour afficher une page d'erreur 404

Affiche un message d'erreur et un lien pour revenir à l'accueil

-->

<%- include('../layout', { body: `
<div
  class="d-flex flex-column justify-content-center align-items-center text-center mt-5"
>
  <h1 class="display-1 text-danger mb-3">404</h1>
  <h2 class="mb-3">Page non trouvée</h2>
  <p class="lead mb-4">
    La page que vous recherchez n'existe pas ou a été déplacée.
  </p>
  <a href="/" class="btn btn-secondary btn-lg">Retour à l'accueil</a>
</div>
`}) %>
