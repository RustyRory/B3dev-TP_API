<!-- 

Path: serveurExpress/src/views/pages/tchat.ejs
Title: Tchat - TP Node.js

Utilise le layout principal pour afficher une page de tchat
avec un formulaire pour envoyer des messages
et une modal pour entrer le pseudo

-->

<%- include('../layout', { content: `
<!-- Modal pour le pseudo -->
<div
  class="modal fade"
  id="pseudo"
  tabindex="-1"
  aria-hidden="true"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="card-title">Entrez votre pseudo</h5>
      </div>
      <div class="modal-body">
        <form id="pseudo-form">
          <input
            id="pseudo-input"
            class="form-control"
            placeholder="Votre pseudo"
            required
          />
          <button type="submit" class="btn btn-secondary mt-3 w-100">
            Valider
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Conteneur principal du tchat -->
<div class="container my-5">
  <h2 class="mb-4 text-center">Tchat</h2>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <!-- Titre du salon -->
      <h5 class="card-title text-center mb-4">
        Salon : <span id="current-room">Général</span>
      </h5>

      <!-- Navigation pills pour les rooms -->
      <ul
        class="nav nav-pills card-header-pills mb-3"
        id="roomPills"
        role="tablist"
      >
        <!-- Boutton pour le salon général (par défaut) -->
        <li class="nav-item">
          <button class="nav-link active" data-room="general" type="button">
            Général
          </button>
        </li>
        <!-- Boutton pour le salon channel -->
        <li class="nav-item">
          <button class="nav-link" data-room="channel" type="button">
            Channel
          </button>
        </li>
        <!-- Boutton pour le salon admin -->
        <li class="nav-item">
          <button
            class="nav-link"
            id="admin-tab"
            data-room="admin"
            type="button"
          >
            Admin
          </button>
        </li>
      </ul>
      <!---- Zone d'affichage des messages -->
      <div
        id="tchat"
        class="card-body"
        style="
          height: 400px;
          overflow-y: auto;
          background-color: #f8f9fa;
          border-radius: 0.25rem;
        "
      ></div>
    </div>
  </div>
  <!-- Formulaire pour envoyer des messages -->
  <form id="tchat-form" class="d-flex">
    <input
      id="input"
      class="form-control me-2"
      autocomplete="off"
      placeholder="Écrire un message..."
    />
    <!-- Bouton d'envoi du message -->
    <button class="btn btn-secondary" type="submit">Envoyer</button>
  </form>
</div>
` }) %>
