<!--
Path: serveurExpress/src/views/partials/styles.ejs
Title: Styles personnalisés attachés au layout principal

Styles CSS pour les onglets de navigation
permettant de différencier l'onglet actif des autres.
Le style étant primary par défault avec Bootstrap,
il est modifié ici pour utiliser la couleur secondary.

-->
<!-- Intégration Bootstrap CSS -->
<link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
  rel="stylesheet"
/>

<style>
  /* Onglets NON actifs */
  .nav-pills .nav-link {
    color: var(--bs-secondary);
  }

  /* Onglet ACTIF */
  .nav-pills .nav-link.active,
  .nav-pills .show > .nav-link {
    background-color: var(--bs-secondary);
    color: #fff;
  }
</style>
